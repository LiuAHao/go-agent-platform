# Go Agent Platform - 环境变量配置

# ========================================
# 应用配置
# ========================================
APP_NAME=go-agent-platform
APP_MODE=development
HTTP_ADDR=:8081
ADMIN_HTTP_ADDR=:8082
JWT_SECRET=your-jwt-secret-change-in-production

# ========================================
# MySQL 配置
# ========================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=agent_platform_cloud
MYSQL_USER=agent
MYSQL_PASSWORD=agent123
MYSQL_ROOT_PASSWORD=root123
MYSQL_MAX_CONNECTIONS=100
MYSQL_MAX_IDLE_CONNECTIONS=10

# ========================================
# Redis 配置
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ========================================
# RabbitMQ 配置
# ========================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

# ========================================
# MinIO 配置
# ========================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_SKILLS=skills
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_EXPORTS=exports

# ========================================
# 用户配置
# ========================================
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# ========================================
# 存储驱动
# ========================================
STORAGE_DRIVER=mysql

# ========================================
# LLM 配置 (密钥必须从环境变量读取，禁止硬编码)
# ========================================
LLM_API_KEY=${LLM_API_KEY}
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
